# ─────────────────────────────────────────────────────────────────────────────
# FinanceFlux — .gitignore raíz del proyecto
# ─────────────────────────────────────────────────────────────────────────────

# Variables de entorno (credenciales — NO subir)
.env

# Archivos de sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Carpetas de dependencias y compilación (respaldo de seguridad)
node_modules/
dist/
target/
build/
bin/

# Configuraciones de IDEs y Editores
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.classpath
.project

